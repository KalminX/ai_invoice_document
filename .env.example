# AI Invoice & Document Extraction Pipeline Environment Configuration

# Django Settings
DJANGO_SECRET_KEY=django-insecure-ai-invoice-pipeline-portfolio-secret-key-replace-in-prod
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Gemini AI Extraction
# Leave empty to automatically use high-fidelity mock extraction mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Extraction Mode: 'auto' (use Gemini if key present, else mock), 'gemini' (require API key), 'mock' (force mock)
EXTRACTION_MODE=auto

# Storage & Upload Limits
MAX_UPLOAD_SIZE_MB=10

# Accounting Adapter Configuration
DEFAULT_ACCOUNTING_ADAPTER=mock
MOCK_ACCOUNTING_FAILURE_RATE=0.0
